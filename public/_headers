# Immutable Next.js build assets.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Long-lived public branding/mascot assets. These filenames only change on a
# deployment, so browser revalidation on every visit is unnecessary.
/logo.png
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400
/nich/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400
/about/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400
