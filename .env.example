# Public Supabase browser settings used by the community feed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_anon_or_publishable_key

# NICH AI provider:
# auto = Ollama locally; Gemini on a hosted website; local CSBT fallback
# ollama = fully local and unlimited on the computer running the Next.js server
# gemini = hosted Gemini API for a public website
# off = rule-based NICH only
NICH_AI_PROVIDER=auto

# Fully free local AI through Ollama.
NICH_OLLAMA_URL=http://127.0.0.1:11434
NICH_OLLAMA_MODEL=qwen3.5:4b
NICH_OLLAMA_THINK=false
NICH_OLLAMA_NUM_CTX=4096
NICH_OLLAMA_MAX_TOKENS=500
NICH_OLLAMA_KEEP_ALIVE=30m
NICH_OLLAMA_TIMEOUT_MS=120000

# Hosted website AI through the Gemini API.
# Keep this server-side. Never rename it to NEXT_PUBLIC_GEMINI_API_KEY.
# Leave blank locally when using only Ollama.
GEMINI_API_KEY=

# NICH uses Gemini 3.6 Flash for AI-needed text, with Flash-Lite only as an outage fallback.
# Local Max still handles normal value lookups, inventory, offer building, etc. without Gemini.
NICH_GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
NICH_GEMINI_MAX_TOKENS=600
NICH_GEMINI_THINKING_LEVEL=minimal
NICH_GEMINI_TIMEOUT_MS=45000
NICH_AI_STYLE_MODE=advice

# Credit Saver defaults. Local NICH handles unknown/trading/advice wording first.
# Gemini text is used only when the user explicitly asks for AI unless you
# intentionally turn one of these overrides on.
NICH_ALLOW_AI_FALLBACK=false
NICH_ALLOW_AI_TRADE_EXPLANATIONS=false
NICH_ALLOW_AI_ADVICE=false
NICH_GEMINI_TEXT_DAILY_LIMIT=25
NICH_AI_CACHE_TTL_MS=21600000

# Screenshot / vision recognition. CSBT verifies detected names against its own database
# and calculates values/WFL locally after recognition.
NICH_GEMINI_VISION_ENABLED=true
NICH_GEMINI_VISION_MODEL=gemini-3.6-flash
NICH_GEMINI_VISION_THINKING_LEVEL=minimal
NICH_GEMINI_VISION_MEDIA_RESOLUTION=high
NICH_GEMINI_VISION_MULTIVIEW_ENABLED=false
NICH_GEMINI_VISION_MAX_TOKENS=4096
NICH_GEMINI_VISION_TIMEOUT_MS=52000
NICH_GEMINI_VISION_MAX_IMAGE_BYTES=2097152
NICH_GEMINI_VISION_RATE_LIMIT=6
# Soft per-server-instance safety cap. Also set a Google billing budget/alert for a real account-level guard.
NICH_GEMINI_VISION_DAILY_LIMIT=100
# Exact repeated screenshots reuse a verified result on warm servers for 24h.
NICH_GEMINI_VISION_CACHE_TTL_MS=86400000

# Server-only Supabase secret key. Needed for value-history snapshots and value alerts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# NICH vision quality controls. A focused second pass only rechecks uncertain slots.
NICH_GEMINI_VISION_FOCUSED_RECHECK_ENABLED=true
# Admin/development diagnostics only. Keep false in normal production.
NICH_VISION_DEBUG=false
