# Public Supabase browser settings used by the community feed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_anon_or_publishable_key

# NICH AI provider:
# auto = Ollama locally; Gemini free tier on a hosted website; local CSBT fallback
# ollama = fully local and unlimited on the computer running the Next.js server
# gemini = hosted free-tier AI for a public website
# off = rule-based NICH only
NICH_AI_PROVIDER=auto

# Fully free local AI through Ollama.
NICH_OLLAMA_URL=http://127.0.0.1:11434
NICH_OLLAMA_MODEL=qwen3.5:4b
NICH_OLLAMA_THINK=false
NICH_OLLAMA_NUM_CTX=4096
NICH_OLLAMA_MAX_TOKENS=500
NICH_OLLAMA_KEEP_ALIVE=30m
NICH_OLLAMA_TIMEOUT_MS=120000

# Hosted website AI through the Gemini API free tier.
# Keep this server-side. Never rename it to NEXT_PUBLIC_GEMINI_API_KEY.
# Leave blank locally when using only Ollama.
GEMINI_API_KEY=

# NICH tries the strongest model first, then the lighter model if unavailable.
NICH_GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
NICH_GEMINI_MAX_TOKENS=800
NICH_GEMINI_TIMEOUT_MS=45000

# Server-only Supabase secret key. Needed for value-history snapshots and value alerts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
